PORT=5000
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_tracker_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Authentication: replace the placeholder below. The server refuses to start with it,
# or with a secret shorter than 32 characters. e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h

# Only used by: npm run create-admin  (set them on the command line instead if you prefer)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please
